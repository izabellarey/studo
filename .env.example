
#example for local configuration
# the file .env is not versionated (.gitignore)

# Alle Werte haben in docker-compose.yml Standardwerte hinterlegt,
# all values have been initialized as a standard in the docker-compose.yml, so the system also starts without a .env


# ports on the host
WEB_PORT=8080
DB_PORT=5432

# database
DB_NAME=stundenplanung
DB_USER=stundenplanung
DB_PASSWORT=change-please

# external host adresses
EXTERNE_BASIS_URL=http://localhost:8080
APP_STANDARD_API_URL=http://localhost:8080/api

# security
JWT_SECRET=replace-with-your-local-development-secret
CORS_ALLOWED_ORIGINS=http://localhost:8081
